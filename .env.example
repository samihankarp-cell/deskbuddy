# Copy this file to .env and fill in your own key. .env is never committed.
# Pick a provider on the dashboard Settings page (or set DESKBUDDY_PROVIDER to one of: nvidia, openai,
# anthropic, gemini, openrouter, groq, together, mistral, deepseek, ollama, lmstudio, custom).
# Saving there applies at once; no restart. The address and models below follow the provider.
DESKBUDDY_PROVIDER=nvidia
DESKBUDDY_API_KEY=
DESKBUDDY_BASE_URL=https://integrate.api.nvidia.com/v1
DESKBUDDY_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b
DESKBUDDY_AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
DESKBUDDY_HOTKEY=right ctrl
DESKBUDDY_WS_PORT=8765
DESKBUDDY_WHISPER=small
DESKBUDDY_LANGUAGE=en

# Optional. From https://app.composio.dev . Lets Desk Buddy reach Gmail, Drive and others directly.
# Or skip this and add Composio (or any tool server) as an MCP server in Settings.
COMPOSIO_API_KEY=
